// RUN: %aslopt -O0 -Obounded %s | filecheck --check-prefix=XFORM %s
// RUN: %aslrun -Obounded %s | filecheck %s

// Copyright (C) 2026-2026 Intel Corporation

function FUT(dividend : Bits(128), divisor : Bits(64)) -> Bits(128)
begin
    let x := Unsigned(dividend);
    let y := Unsigned(divisor);
    let r := Truncated_Divide(x, y);
    return r[0 +: 128];
end

// XFORM-LABEL: function FUT.0{}(dividend : Bits(128), divisor : Bits(64)) -> Bits(128)
// XFORM-NEXT:  begin
// XFORM-NEXT:      let x : __sint(129) := Std::SInt::Unsigned.0{128}(dividend);
// XFORM-NEXT:      let y : __sint(65) := Std::SInt::Unsigned.0{64}(divisor);
// XFORM-NEXT:      let r : __sint(130) := Std::SInt::Truncated_Divide.0{130}(Std::SInt::Resize.0{129, 130}(x, 130), Std::SInt::Resize.0{65, 130}(y, 130));
// XFORM-NEXT:      return {Integer}Std::SInt::To_Integer.0{130}(r)[Std::SInt::To_Integer.0{1}(i1'x0) +: Std::SInt::To_Integer.0{9}(i9'x128)];
// XFORM-NEXT:  end

function main() -> Builtin::Foreign::CInt
begin
    Std::Print::Bits::Hex(FUT(All_Ones(128), Zero_Extend(0b1, 64)));
    // CHECK: 128'xffffffffffffffffffffffffffffffff
    return Builtin::Foreign::CInt::From_Integer(0);
end
