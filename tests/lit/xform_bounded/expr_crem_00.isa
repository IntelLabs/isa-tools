// RUN: %aslopt -O0 -Obounded %s | filecheck --check-prefix=XFORM %s
// RUN: %aslrun -Obounded %s | filecheck %s

// Copyright (C) 2026-2026 Intel Corporation

function FUT(x : {-8..7}, y : {-8..7}) -> {-7..7}
begin
    return Ceiling_Remainder(x, y);
end

// XFORM-LABEL: function FUT.0{}(x : __sint(4), y : __sint(4)) -> __sint(4)
// XFORM-NEXT:  begin
// XFORM-NEXT:      return Std::SInt::Ceiling_Remainder.0{4}(x, y);
// XFORM-NEXT:  end

function main() -> Builtin::Foreign::CInt
begin
    Std::Print::Integer::Dec(FUT(5, 3));
    // CHECK: -1
    Std::Print::Integer::Dec(FUT(5, -3));
    // CHECK: 2
    return Builtin::Foreign::CInt::From_Integer(0);
end
